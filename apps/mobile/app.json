{
  "expo": {
    "name": "Qrono",
    "slug": "qrono-mobile",
    "owner": "qrono",
    "scheme": "qrono",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0d12",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0d12"
    },
    "ios": {
      "bundleIdentifier": "uk.co.qrono.app",
      "supportsTablet": false
    },
    "android": {
      "package": "uk.co.qrono.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0712",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A97BFF"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/31a3c6e8-b533-445a-ba52-77d9b7fe0f67"
    },
    "extra": {
      "eas": {
        "projectId": "31a3c6e8-b533-445a-ba52-77d9b7fe0f67"
      }
    }
  }
}
