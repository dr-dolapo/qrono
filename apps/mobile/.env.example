# The Qrono web address the app talks to (the API is under /api on the same address).
# Copy this file to .env and change it. No trailing slash.
#
# Your deployed Qrono, e.g.:
EXPO_PUBLIC_QRONO_URL=https://qrono-web.YOUR-SUBDOMAIN.workers.dev
#
# Or your computer while developing (see README → "Use your local API"):
# EXPO_PUBLIC_QRONO_URL=http://192.168.1.20:5173
